{
    email ${ACME_EMAIL:-admin@medpronto.com.br}
}

# Suporta acesso por qualquer IP de VPS, sslip.io ou domínio externo
{$DOMAIN_NAME:-localhost}, :80, :443 {
    handle /api/* {
        reverse_proxy backend:3001
    }

    handle /socket.io/* {
        reverse_proxy backend:3001
    }

    handle /uploads/* {
        reverse_proxy backend:3001
    }

    handle {
        reverse_proxy frontend:80
    }
}
